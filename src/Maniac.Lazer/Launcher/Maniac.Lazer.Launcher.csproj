<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <NoWarn>$(NoWarn);CS2008</NoWarn>
    <CopyBuildOutputToOutputDirectory>false</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <UseAppHost>false</UseAppHost>
    <DebugType>none</DebugType>
    <ManiacPack Condition="'$(ManiacPack)' == ''">false</ManiacPack>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bootstrap\Maniac.Lazer.Bootstrap.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Plugin\Maniac.Lazer.Plugin.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <Target Name="CollectPluginFiles" DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <_StubDir>$([System.IO.Path]::Combine($(MSBuildThisFileDirectory), '..', 'Bootstrap', 'bin', '$(Configuration)', '$(TargetFramework)'))</_StubDir>
      <_PluginDir>$([System.IO.Path]::Combine($(MSBuildThisFileDirectory), '..', 'Plugin', 'bin', '$(Configuration)', '$(TargetFramework)'))</_PluginDir>
    </PropertyGroup>
    <ItemGroup>
      <_PluginFiles Remove="@(_PluginFiles)" />
      <_PluginFiles Include="$(_StubDir)/Maniac.dll" />
      <_PluginFiles Include="$(_StubDir)/Maniac.pdb" Condition="Exists('$(_StubDir)/Maniac.pdb')" />
      <_PluginFiles Include="$(_StubDir)/Maniac.runtimeconfig.json" Condition="Exists('$(_StubDir)/Maniac.runtimeconfig.json')" />
      <_PluginFiles Include="$(_StubDir)/Maniac.deps.json" Condition="Exists('$(_StubDir)/Maniac.deps.json')" />
      <_PluginFiles Include="$(_StubDir)/*Harmony*.dll" />
      <_PluginFiles Include="$(_PluginDir)/Maniac.Plugin.dll" />
      <_PluginFiles Include="$(_PluginDir)/Maniac.Plugin.pdb" Condition="Exists('$(_PluginDir)/Maniac.Plugin.pdb')" />
      <_PluginFiles Include="$(_PluginDir)/Maniac.Core.dll" />
      <_PluginFiles Include="$(_PluginDir)/Maniac.Core.pdb" Condition="Exists('$(_PluginDir)/Maniac.Core.pdb')" />
    </ItemGroup>
  </Target>
  <Target Name="CopyPlugin" AfterTargets="Build" DependsOnTargets="CollectPluginFiles">
    <PropertyGroup>
      <_StageDir>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), 'obj', '$(Configuration)', 'plugin'))</_StageDir>
    </PropertyGroup>
    <MakeDir Directories="$(_StageDir)" />
    <Copy SourceFiles="@(_PluginFiles)" DestinationFolder="$(_StageDir)" SkipUnchangedFiles="true" Condition="Exists('$(_StubDir)/Maniac.dll')" />
  </Target>
  <Target Name="BuildNativeLauncher" AfterTargets="CopyPlugin">
    <PropertyGroup>
      <_Pwsh Condition="'$(OS)' == 'Windows_NT'">powershell.exe</_Pwsh>
      <_Pwsh Condition="'$(OS)' != 'Windows_NT'">pwsh</_Pwsh>
      <_NativeOut>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine($(MSBuildProjectDirectory), '$(OutputPath)'))))</_NativeOut>
      <_NativeOut>$(_NativeOut.TrimEnd('\').TrimEnd('/'))</_NativeOut>
      <_StageDir>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), 'obj', '$(Configuration)', 'plugin'))</_StageDir>
      <_StageDir>$(_StageDir.TrimEnd('\').TrimEnd('/'))</_StageDir>
      <_NativeArgs>-Configuration $(Configuration) -OutputDir "$(_NativeOut)" -PluginDir "$(_StageDir)"</_NativeArgs>
      <_NativeArgs Condition="'$(ManiacBuildExpiry)' != ''">$(_NativeArgs) -Expiry "$(ManiacBuildExpiry)"</_NativeArgs>
      <_NativeArgs Condition="'$(ManiacPack)' == 'true'">$(_NativeArgs) -Embed</_NativeArgs>
    </PropertyGroup>
    <Exec Command="$(_Pwsh) -NoProfile -File &quot;$(MSBuildThisFileDirectory)build.ps1&quot; $(_NativeArgs)" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
