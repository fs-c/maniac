<Page
    x:Class="Maniac.Stable.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer Padding="36,12,36,32">
        <StackPanel MaxWidth="800" Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="General" />
            <InfoBar
                x:Name="ExpiryBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Autoplay" />
                        <TextBlock Style="{StaticResource SettingDescription}" Text="Master switch for sending autoplay input. Keys are sent only while the osu! window is already in the foreground." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="AutoplayToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="AutoplayToggle_Toggled" />
                </Grid>
            </Border>
            <Border Padding="0" Style="{StaticResource SettingsCard}">
                <Expander
                    x:Name="StatusExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    IsExpanded="False">
                    <Expander.Resources>
                        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
                    </Expander.Resources>
                    <Expander.Header>
                        <StackPanel Margin="0,8,12,8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Status" />
                            <TextBlock
                                x:Name="StatusSummary"
                                Style="{StaticResource SettingDescription}"
                                Text="not attached" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,4,0,4" Spacing="12">
                        <InfoBar
                            x:Name="DiagBar"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational" />
                        <Grid ColumnSpacing="16" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource StatusLabel}" Text="Process" />
                            <TextBlock x:Name="ProcessText" Grid.Row="0" Grid.Column="1" Style="{StaticResource StatusValue}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource StatusLabel}" Text="Layout" />
                            <TextBlock x:Name="LayoutText" Grid.Row="1" Grid.Column="1" Style="{StaticResource StatusValue}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource StatusLabel}" Text="Ruleset" />
                            <TextBlock x:Name="RulesetText" Grid.Row="2" Grid.Column="1" Style="{StaticResource StatusValue}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource StatusLabel}" Text="Screen" />
                            <TextBlock x:Name="ScreenText" Grid.Row="3" Grid.Column="1" Style="{StaticResource StatusValue}" />
                            <TextBlock Grid.Row="4" Style="{StaticResource StatusLabel}" Text="Audio time" />
                            <TextBlock x:Name="TimeText" Grid.Row="4" Grid.Column="1" Style="{StaticResource StatusValue}" />
                            <TextBlock Grid.Row="5" Style="{StaticResource StatusLabel}" Text="Progress" />
                            <TextBlock x:Name="ProgressText" Grid.Row="5" Grid.Column="1" Style="{StaticResource StatusValue}" />
                            <TextBlock Grid.Row="6" Style="{StaticResource StatusLabel}" Text="Columns" />
                            <TextBlock x:Name="ColumnsText" Grid.Row="6" Grid.Column="1" Style="{StaticResource StatusValue}" />
                            <TextBlock Grid.Row="7" Style="{StaticResource StatusLabel}" Text="Paused" />
                            <TextBlock x:Name="PausedText" Grid.Row="7" Grid.Column="1" Style="{StaticResource StatusValue}" />
                            <TextBlock Grid.Row="8" Style="{StaticResource StatusLabel}" Text="Foreground" />
                            <TextBlock x:Name="ForegroundText" Grid.Row="8" Grid.Column="1" Style="{StaticResource StatusValue}" />
                            <TextBlock Grid.Row="9" Style="{StaticResource StatusLabel}" Text="Playing" />
                            <TextBlock x:Name="PlayingText" Grid.Row="9" Grid.Column="1" Style="{StaticResource StatusValue}" />
                            <TextBlock Grid.Row="10" Style="{StaticResource StatusLabel}" Text="Keys" />
                            <TextBlock x:Name="KeysText" Grid.Row="10" Grid.Column="1" Style="{StaticResource StatusValue}" />
                            <TextBlock Grid.Row="11" Style="{StaticResource StatusLabel}" Text="Version" />
                            <TextBlock x:Name="VersionText" Grid.Row="11" Grid.Column="1" Style="{StaticResource StatusValue}" />
                            <TextBlock Grid.Row="12" Style="{StaticResource StatusLabel}" Text="Settings" />
                            <TextBlock x:Name="SettingsText" Grid.Row="12" Grid.Column="1" Style="{StaticResource StatusValue}" />
                        </Grid>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
