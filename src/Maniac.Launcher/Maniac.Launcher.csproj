<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('windows'))">net8.0-windows</TargetFramework>
    <RootNamespace>Maniac.Launcher</RootNamespace>
    <AssemblyName>maniac</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <HostArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</HostArchitecture>
    <_DefaultUseInjectDotnet>false</_DefaultUseInjectDotnet>
    <_DefaultUseInjectDotnet Condition="$([MSBuild]::IsOSPlatform('windows')) AND '$(HostArchitecture)' == 'X64'">true</_DefaultUseInjectDotnet>
    <UseInjectDotnet Condition="'$(UseInjectDotnet)' == ''">$(_DefaultUseInjectDotnet)</UseInjectDotnet>
    <DefineConstants Condition="'$(UseInjectDotnet)' == 'true'">$(DefineConstants);USE_INJECTDOTNET</DefineConstants>
    <PlatformTarget Condition="'$(UseInjectDotnet)' == 'true'">x64</PlatformTarget>
    <Platforms Condition="'$(UseInjectDotnet)' == 'true'">x64</Platforms>
    <Platform Condition="'$(UseInjectDotnet)' == 'true' AND ('$(Platform)' == '' or '$(Platform)' == 'AnyCPU')">x64</Platform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.621003" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseInjectDotnet)' == 'true'">
    <PackageReference Include="InjectDotnet" Version="0.4.0">
      <ExcludeAssets>build;buildTransitive</ExcludeAssets>
    </PackageReference>
    <Reference Include="InjectDotnet">
      <HintPath>$([System.IO.Path]::Combine($(NuGetPackageRoot), 'injectdotnet', '0.4.0', 'build', 'net8.0-windows7.0', 'x64', 'InjectDotnet.dll'))</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseInjectDotnet)' != 'true'">
    <Compile Remove="WindowsRemoteInject.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-windows'">
    <Compile Remove="WindowsOsuWindows.cs" />
    <Compile Remove="WindowsProcessImagePath.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Compile Remove="MacProcessImagePath.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Maniac.Bootstrap\Maniac.Bootstrap.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Maniac.Plugin\Maniac.Plugin.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Maniac.Core\Maniac.Core.csproj" />
  </ItemGroup>
  <Target Name="CopyPlugin" AfterTargets="Build">
    <PropertyGroup>
      <_StubDir>$(MSBuildThisFileDirectory)..\Maniac.Bootstrap\bin\$(Configuration)\net8.0</_StubDir>
      <_PluginDir>$(MSBuildThisFileDirectory)..\Maniac.Plugin\bin\$(Configuration)\net8.0</_PluginDir>
    </PropertyGroup>
    <ItemGroup>
      <_PluginFiles Include="$(_StubDir)/Maniac.dll" />
      <_PluginFiles Include="$(_StubDir)/Maniac.pdb" Condition="Exists('$(_StubDir)/Maniac.pdb')" />
      <_PluginFiles Include="$(_StubDir)/Maniac.runtimeconfig.json" Condition="Exists('$(_StubDir)/Maniac.runtimeconfig.json')" />
      <_PluginFiles Include="$(_StubDir)/Maniac.deps.json" Condition="Exists('$(_StubDir)/Maniac.deps.json')" />
      <_PluginFiles Include="$(_StubDir)/*Harmony*.dll" />
      <_PluginFiles Include="$(_PluginDir)/Maniac.Plugin.dll" />
      <_PluginFiles Include="$(_PluginDir)/Maniac.Plugin.pdb" Condition="Exists('$(_PluginDir)/Maniac.Plugin.pdb')" />
      <_PluginFiles Include="$(_PluginDir)/Maniac.Core.dll" />
      <_PluginFiles Include="$(_PluginDir)/Maniac.Core.pdb" Condition="Exists('$(_PluginDir)/Maniac.Core.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginFiles)" DestinationFolder="$(OutputPath)plugin" SkipUnchangedFiles="true" />
  </Target>
</Project>
